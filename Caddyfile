{
	auto_https off
	# Wunsch #126: Admin-API komplett abgeschaltet. Sie lauschte vorher auf
	# 172.30.0.10:2019 – also auf dem internen Bridge-Netz, in dem auch der
	# portal-Container hängt, und ohne jede Authentifizierung. Damit konnte
	# jeder, der im portal-Container eine ausgehende Anfrage steuern kann
	# (z. B. über den Rezept-Import, siehe Wunsch #127), die komplette
	# Caddy-Konfiguration lesen UND per POST/PATCH überschreiben – bis hin
	# zum Umbiegen von portal.16schwaben.de auf einen fremden Server.
	# Wir brauchen die API nicht: die Konfiguration kommt aus dieser Datei,
	# Änderungen gehen über ein Neuaufsetzen des Containers.
	admin off
}

portal.16schwaben.de {
	tls /certs/fullchain.pem /certs/privkey.pem
	header {
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		# Wunsch #107: statt X-Frame-Options DENY (blockiert JEDES Einbetten,
		# egal von wo) gezielt per CSP frame-ancestors nur Home Assistant
		# (Kiosk-Dashboard im Esszimmer) erlauben. frame-ancestors ersetzt
		# X-Frame-Options vollstaendig auf modernen Browsern (Chrome/Safari) -
		# beide gleichzeitig zu setzen waere widerspruechlich, da ein reines
		# X-Frame-Options DENY das Einbetten weiterhin verbieten wuerde, selbst
		# wenn CSP es erlaubt.
		# Wunsch #132: CSP über frame-ancestors hinaus gehärtet.
		#
		# Ziel laut Wunsch: Wenn doch einmal eine XSS-Lücke entsteht, soll der
		# Zugangstoken nicht an einen fremden Server abfließen können.
		# `connect-src`, `img-src` und `form-action` auf 'self' schneiden genau
		# die üblichen Abflusswege ab (fetch/XHR, Bild-Beacon, Formular-POST),
		# `script-src 'self'` verhindert zusätzlich das Nachladen fremder
		# Skripte, `object-src 'none'` und `base-uri 'self'` schließen zwei
		# klassische Umgehungen.
		#
		# 'unsafe-inline' bleibt bei script-src und style-src drin, und das ist
		# eine bewusste Entscheidung, keine Nachlässigkeit: die Templates
		# enthalten 59 Inline-Handler (onclick/onsubmit) in 27 Dateien,
		# 30 Inline-<script>-Blöcke und 199 style="..."-Attribute. Ein echtes
		# Nonce würde all das auf einen Schlag lahmlegen. Der Umbau auf
		# addEventListener ist als eigener Wunsch erfasst – erst danach kann
		# 'unsafe-inline' bei script-src raus. Was hier steht, wirkt trotzdem
		# sofort: eingeschleuster Code kann zwar laufen, aber den Token nicht
		# mehr ohne Weiteres nach außen schicken.
		#
		# Nicht abgedeckt bleibt der Abfluss per Navigation
		# (location.href = 'https://fremd/?t=...') – dafür gibt es in CSP
		# schlicht kein Mittel mehr, seit `navigate-to` aus dem Standard
		# gefallen ist.
		# Wunsch #142: Die CSP steht seit Stufe 5 NICHT mehr hier, sondern in
		# `src/teile/21_csp.py`. Grund: `script-src` arbeitet jetzt mit einem
		# Nonce, das je Anfrage neu erzeugt und in dieselbe Antwort geschrieben
		# werden muss, in der es auch in den <script>-Tags steht. Caddy sieht
		# die Vorlage nicht; ein festes Nonce hier wäre wertlos, weil es sich
		# abschreiben liesse.
		#
		# Bewusst KEINE zweite CSP an dieser Stelle: Zwei Regeln gelten
		# gleichzeitig und im Schnitt (eine Ressource muss BEIDE erfüllen).
		# Eine hier vergessene, freizügige Regel würde das nicht auffangen -
		# sie würde nur die Fehlersuche unübersichtlich machen, weil im
		# Browser zwei Richtlinien nebeneinander stünden.
		# Wunsch #134: HSTS. Das Portal hört nur auf 443, gerade deshalb ist
		# Port 80 auf 10.0.0.200 unbesetzt – ein Gerät im LAN könnte die IP
		# per ARP-Spoofing übernehmen, dort antworten und den Zugangstoken
		# im Klartext abgreifen, sobald jemand die Adresse ohne https eintippt
		# oder einem alten http-Lesezeichen folgt. Bewusst OHNE
		# includeSubDomains: das würde für alle *.16schwaben.de gelten, auch
		# für Dienste, die hier gar nicht konfiguriert sind.
		Strict-Transport-Security "max-age=31536000"
		# Wunsch #208 (Sicherheitsaudit 11.08.2026): Ohne diesen Header darf
		# grundsaetzlich jede eingebettete oder eingeschleuste Ressource
		# Kamera, Mikrofon, Standort etc. anfragen - selbst wenn eine
		# erfolgreiche Einschleusung durch die bestehende CSP schon sehr
		# unwahrscheinlich ist (Verteidigung in der Tiefe). Das Portal selbst
		# braucht fast keine dieser APIs: Fotos (Rezepte, Vokabeln, Barcode)
		# laufen ueber den normalen Datei-Upload-Dialog (<input type=file>),
		# nicht ueber getUserMedia. `interest-cohort`/`browsing-topics`
		# schaltet zusaetzlich Googles FLoC/Topics-Tracking ab - kostet nichts,
		# nutzt aber auch nichts, ohne dass irgendjemand es verlangt hat.
		#
		# Wunsch #258 (05.09.2026): `microphone=(self)` - das Aussprache-
		# Training im Vokabeltrainer nimmt per getUserMedia auf. `self` heisst:
		# nur Seiten dieser Herkunft, keine eingebetteten fremden Rahmen; der
		# Browser fragt trotzdem bei jedem Nutzer einmal nach. Kamera bleibt zu.
		#
		# BEWUSST NICHT dabei: Cross-Origin-Opener-Policy/-Resource-Policy.
		# Beide koennten das Einbetten im Home-Assistant-iFrame (Kiosk,
		# frame-ancestors oben) stoeren, falls HA selbst Cross-Origin-
		# Fensterzugriff braucht - das laesst sich nur an einem echten Geraet
		# pruefen, nicht von hier aus. Siehe Wunsch #208 in der Werkstatt.
		Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), midi=(), interest-cohort=(), browsing-topics=()"
		-Server
	}
	# Wunsch #133: Anfragen mit übergroßem Body gar nicht erst durchreichen.
	# Der portal-Container hat 256 MB RAM-Limit; ohne diese Grenze könnten
	# parallele Riesen-Uploads ihn ins OOM schicken. 12 MB lässt genug Luft
	# über dem 10-MB-Limit in Flask (MAX_CONTENT_LENGTH), damit die
	# freundliche Fehlermeldung der App greift und nicht Caddy stumm abbricht.
	request_body {
		max_size 12MB
	}
	reverse_proxy portal:8000
}

# Wunsch #126: Ersatz für den bisherigen Healthcheck, der die abgeschaltete
# Admin-API abfragte. Bewusst ein eigener Klartext-Listener auf dem Loopback
# des caddy-Containers statt eines Pfads in der öffentlichen Site:
#   - er ist von außen und aus dem intern-Netz gar nicht erreichbar,
#   - und busybox-wget (im caddy-Image) kann kein SNI setzen; ein TLS-Aufruf
#     auf 127.0.0.1 scheitert deshalb am Handshake, weil Caddy die Site ohne
#     SNI nicht zuordnen kann ("tlsv1 alert internal error" – live gesehen).
# Caddy beantwortet das selbst, der Check bleibt also grün, während der
# portal-Container neu startet.
:2020 {
	bind 127.0.0.1
	respond "ok" 200
}

# Interner Relay für Sportschau-App (Wunsch #62): portal hängt nur im Bridge-
# Netz und kann den hae-Server (10.0.0.199, macvlan-IP auf demselben Host)
# nicht direkt erreichen. caddy schon (eigene macvlan-IP, gleiches L2-Segment)
# und reicht die Anfrage 1:1 weiter (Header inkl. api-key bleiben erhalten).
# Per IP statt Hostname, weil health-api.16schwaben.de nur über Pi-hole
# (10.0.0.194) auflösbar ist, home02 aber einen anderen DNS-Server nutzt -
# kein Host-Eingriff nötig, da alles innerhalb unseres eigenen Caddyfiles
# gelöst wird. Nur auf dem internen Bridge-Netz erreichbar, nie auf
# 10.0.0.200 oder nach außen.
:2021 {
	bind 172.30.0.10
	reverse_proxy 10.0.0.199:443 {
		header_up Host health-api.16schwaben.de
		transport http {
			tls
			tls_server_name health-api.16schwaben.de
		}
	}
}
