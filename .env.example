# UID/GID des claude-Users auf home02 (docker compose variable substitution)
UID=1001
GID=1001

# Flask Secret Key – generieren mit:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# VAPID-Schlüssel für Web-Push – generieren mit:
#   docker exec portal python3 -c "
#     from cryptography.hazmat.primitives.asymmetric import ec
#     from cryptography.hazmat.primitives import serialization
#     import base64
#     k = ec.generate_private_key(ec.SECP256R1())
#     priv = base64.urlsafe_b64encode(k.private_numbers().private_value.to_bytes(32,'big')).rstrip(b'=').decode()
#     pub  = base64.urlsafe_b64encode(b'\x04' + k.public_key().public_numbers().x.to_bytes(32,'big') + k.public_key().public_numbers().y.to_bytes(32,'big')).rstrip(b'=').decode()
#     print('VAPID_PRIVATE_KEY=' + priv)
#     print('VAPID_PUBLIC_KEY='  + pub)
#   "
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# E-Mail-Adresse für VAPID (erscheint im Push-Header)
VAPID_SUBJECT=mailto:andreas.bosch@gmail.com

# Wunsch #129: Schluessel fuer die Verschluesselung der Zugangstokens in der
# Datenbank. Erzeugen mit:
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# !!! ACHTUNG !!!  Ohne diesen Schluessel ist KEIN Zugang mehr moeglich und
# auch ein wiederhergestelltes /data-Backup nuetzt nichts - das NAS-Backup
# sichert nur /data, diese .env liegt bewusst NICHT darin (genau das macht ein
# geleaktes Backup wertlos). Diese Datei deshalb zusaetzlich an einem zweiten
# sicheren Ort aufbewahren, z. B. im Passwortmanager.
TOKEN_KEY=

# Wunsch #140, Stufe 1: Sitzungs-Cookies ausstellen (1) oder nicht (0).
# In Stufe 1 wird das Cookie nur ANGELEGT und mitgegeben, aber von nichts
# ausgewertet - die Anmeldung laeuft weiter ueber den Token in der Adresse.
# Notausstieg fuer diese Stufe: auf 0 setzen, "docker compose up -d portal".
SITZUNG_AUSSTELLEN=0

# Wunsch #140, Stufe 2: CSRF-Riegel.
#   aus         - keine Pruefung (Ausgangszustand)
#   beobachten  - protokolliert Verdachtsfaelle, blockiert NICHTS
#   scharf      - blockiert mit 403
# Vor dem Scharfschalten im Beobachtungsmodus laufen lassen und pruefen:
#   docker compose logs portal | grep CSRF-Verdacht
CSRF_MODUS=aus

# Erwartete eigene Herkunft fuer die CSRF-Pruefung. Leer lassen = aus der
# Anfrage ableiten; nur setzen, wenn das Portal je unter mehreren Namen laeuft.
PORTAL_ORIGIN=

# Wunsch #140, Stufe 3: Darf das Sitzungs-Cookie als Nachweis gelten?
#   0 - nein, nur der Token in der Adresse zaehlt
#   1 - ja, /start und token-freie Aufrufe funktionieren
# Der Pfad-Token behaelt IMMER Vorrang; ein angegebener aber unguelltiger
# Token faellt bewusst NICHT aufs Cookie zurueck.
SITZUNG_KONSUMIEREN=0

# hae-Server (Health Auto Export) von Andi – Sportschau-App, Wunsch #62.
# Read-Token aus dem hae-Server (.env dort: READ_TOKEN), nicht der Write-Token
# der iPhone-Automation. URL zeigt auf den caddy-internen Relay (Caddyfile),
# nicht direkt auf health-api.16schwaben.de – portal (Bridge-Netz) kann die
# macvlan-IP des hae-Servers sonst nicht erreichen (Hairpin-Problem).
HAE_API_URL=http://caddy:2021/api/workouts
HAE_API_KEY=

# Backup auf NAS per tar+ssh (kein rsync nötig)
BACKUP_NAS_HOST=10.60.0.4
BACKUP_NAS_USER=familienportal
BACKUP_NAS_PATH=/volume2/portal.16schwaben.de_Backup
BACKUP_NAS_PORT=2222
