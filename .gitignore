# Als .gitignore nach C:\Projekte\portal.16schwaben.de\ kopieren

# ── Echte Familiendaten – NIE einchecken ────────────────────────────────
data/
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
backups/
snapshots/

# ── Geheimnisse ─────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.crt
id_rsa*
id_ed25519*
vapid*.json
secrets/
ssh/

# ── Auslieferungspakete (Git ist die Versionierung) ─────────────────────
deploy/*.tar.gz
deploy/*.tgz

# ── Laufzeit / Werkzeuge ────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
test-results/
playwright-report/
*.log

# ── Debug-Artefakte, die versehentlich echte Daten enthalten können ─────
screenshots/
dumps/
*.har

# ── Claude-Code-Sitzungsdateien – gehoeren weder ins Repo noch ins Paket ─
# settings.local.json ist eine gewachsene allow-Liste, die zeitweise ganze
# Zugangs-URLs enthielt (Audit 16.09.2026, #281). Bisher nur ueber die
# globale ~/.config/git/ignore ausgeschlossen - ein frischer Klon auf einem
# anderen Rechner haette das nicht. Deshalb hier ausdruecklich.
.claude/settings.local.json
.claude/scheduled_tasks.lock

# ── Sicherheitsberichte – bleiben lokal ─────────────────────────────────
# Enthalten unbehobene Schwachstellen samt Ausnutzungspfad. Auch ein
# privates Repo ist dafür der falsche Ort: der Bericht ist eine Anleitung,
# solange die Findings offen sind. Entscheidung von Andi, 11.08.2026.
SECURITY_REVIEW.md
